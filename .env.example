# ─────────────────────────────────────────────────────────────────────────────
# Single-Agent Blockchain Investigator — Environment Configuration
# .env.example
#
# Copy to .env and fill in your values before starting the server.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────


# ── Application Identity ──────────────────────────────────────────────────────
APP_NAME="Single-Agent Blockchain Investigator"
APP_VERSION="1.0.0"
APP_ENV="development"
DEBUG=true
SECRET_KEY="CHANGE-ME-generate-with-openssl-rand-hex-32"


# ── API Server ────────────────────────────────────────────────────────────────
API_HOST=127.0.0.1
API_PORT=8080
API_RELOAD=true
API_WORKERS=1
API_PREFIX="/api/v1"
API_KEY="dev-api-key-change-in-production"


# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
CORS_ALLOW_CREDENTIALS=true


# ── Blockchain Data Layer — Etherscan ─────────────────────────────────────────
ETHERSCAN_API_KEY="USER-OWN-ETHERSCAN-API-KEY"
ETHERSCAN_BASE_URL="https://api.etherscan.io/v2/api"
ETHERSCAN_TIMEOUT_SECONDS=30
ETHERSCAN_MAX_RETRIES=3
ETHERSCAN_RETRY_BACKOFF_BASE=1.0


# ── Rate Limiter ──────────────────────────────────────────────────────────────
RATE_LIMIT_REQUESTS_PER_SECOND=4.5
RATE_LIMIT_BURST_CAPACITY=5


# ── LLM Provider — Google Gemini ─────────────────────────────────────────────────
GOOGLE_API_KEY="YOUR-GOOGLE-API-KEY"
GEMINI_MODEL="gemini-2.0-flash"
GEMINI_MAX_TOKENS=8192
GEMINI_TEMPERATURE=0.1


# ── Database — SQLite ─────────────────────────────────────────────────────────
DATABASE_PATH="data/investigations.db"
DATABASE_WAL_MODE=true
DATABASE_BUSY_TIMEOUT_MS=5000
DATABASE_POOL_SIZE=5


# ── Investigation Defaults ────────────────────────────────────────────────────
DEFAULT_INVESTIGATION_DEPTH=2
DEFAULT_LOOKBACK_DAYS=90
DEFAULT_MAX_TRANSACTIONS=500
DEFAULT_FLAG_THRESHOLD_ETH=10.0
DEFAULT_MIN_TRACE_VALUE_ETH=0.05
DEFAULT_MAX_TRACE_NODES=500
DEFAULT_MAX_FAN_OUT_PER_NODE=50
MAX_TRANSACTIONS_HARD_CAP=1000


# ── Trace Scoring Weights ─────────────────────────────────────────────────────
TRACE_WEIGHT_VALUE=0.30
TRACE_WEIGHT_RECENCY=0.20
TRACE_WEIGHT_NOVELTY=0.30
TRACE_WEIGHT_RULE=0.20


# ── Risk Scoring ──────────────────────────────────────────────────────────────
RISK_WEIGHT_CRITICAL=40.0
RISK_WEIGHT_HIGH=20.0
RISK_WEIGHT_MEDIUM=10.0
RISK_WEIGHT_LOW=5.0
RISK_THRESHOLD_CRITICAL=80.0
RISK_THRESHOLD_HIGH=50.0
RISK_THRESHOLD_MEDIUM=25.0


# ── Session & WebSocket ───────────────────────────────────────────────────────
SESSION_TIMEOUT_SECONDS=3600
WS_PING_INTERVAL_SECONDS=30
WS_RECONNECT_WINDOW_SECONDS=60
WS_MAX_EVENT_QUEUE_SIZE=1000


# ── Graph Renderer Thresholds ─────────────────────────────────────────────────
GRAPH_RENDERER_CANVAS_THRESHOLD=500
GRAPH_RENDERER_WEBGL_THRESHOLD=5000


# ── Forensic Rules ────────────────────────────────────────────────────────────
RULE_001_LARGE_TRANSFER_ETH=10.0
RULE_002_RAPID_SUCCESSION_TX_COUNT=5
RULE_002_RAPID_SUCCESSION_WINDOW_SECONDS=300
RULE_003_HIGH_FANOUT_UNIQUE_ADDRESSES=20
RULE_004_DORMANCY_THRESHOLD_DAYS=180
RULE_004_ACTIVATION_WINDOW_HOURS=48
RULE_005_BURST_MULTIPLIER=3.0
RULE_005_ROLLING_WINDOW_DAYS=30
RULE_006_ROUND_NUMBER_MIN_OCCURRENCES=3
RULE_007_NEW_WALLET_AGE_HOURS=24


# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL="DEBUG"
LOG_FORMAT="json"
LOG_FILE=""


# ── Testing ───────────────────────────────────────────────────────────────────
TEST_ETHERSCAN_API_KEY="test-key-not-real"
TEST_DATABASE_PATH=":memory:"